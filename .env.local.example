# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://iqughznrpihzyorewlif.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=evidence

# Supabase Management API (for migrations only)
SUPABASE_ACCESS_TOKEN=your-pat-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider (server-only)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=your-text-model
OPENROUTER_TEXT_MODEL=your-text-model
OPENROUTER_VISION_MODEL=your-vision-model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Accounting Operations Control Tower

# WhatsApp (WAHA) - server-only
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=your-waha-key-here
WAHA_SESSION=your-waha-session
WAHA_WEBHOOK_URL=https://your-app.example.com/api/wa-webhook
WAHA_WEBHOOK_TOKEN=your-webhook-token-here
WHATSAPP_DEFAULT_ENGINE=GOWS

# Background Jobs
CRON_SECRET=generate-with-openssl-rand-hex-32
OCR_LANGUAGE=ind+eng

# Live integration test (staging only, never production)
RUN_LIVE_INTEGRATION=false
LIVE_INTEGRATION_TARGET=staging
INTEGRATION_SUPABASE_URL=https://staging-project.supabase.co
INTEGRATION_SUPABASE_ANON_KEY=your-staging-anon-key-here
INTEGRATION_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-here
INTEGRATION_APP_URL=http://localhost:3000

# Notification (optional)
RESEND_API_KEY=your-resend-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com
